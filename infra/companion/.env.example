# This file belongs only to the separate companion Compose project.
# Copy to .env, restrict its permissions, and replace every placeholder.
# Generate each of the first three values independently with: openssl rand -hex 32
# POSTGRES_PASSWORD must be URL-safe; hex needs no URL escaping.
POSTGRES_PASSWORD=replace-with-independent-random-hex-password
SUPABASE_JWT_SECRET=replace-with-independent-random-hex-signing-secret
CALLER_SECRET=replace-with-independent-random-hex-caller-secret

# Upstream requires this variable even when its OpenRouter endpoints are
# overridden with an OpenAI-compatible service in model-config.toml.
OPENROUTER_API_KEY=replace-with-your-companion-model-service-key

# Only needed if the operator's model config retains native Voyage embeddings.
VOYAGE_API_KEY=
